# Copy to .env and edit. All values are optional; defaults are shown.
# .env is gitignored, never commit real secrets.

# --- Input ---
SEED_FILE=links.txt

# --- What to extract ---
EXTRACT_EMAILS=true
EXTRACT_PHONES=true
EXTRACT_ARTICLES=true
EXTRACT_PRODUCTS=true
EXTRACT_IMAGES=false

# --- AI extraction (Google Gemini) ---
# Only needed for --custom-prompt / CUSTOM_PROMPT. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
CUSTOM_PROMPT=
MAX_LLM_CALLS_PER_DOMAIN=3

# --- Crawl limits ---
MAX_CRAWL_DEPTH=3
MAX_PAGES_PER_DOMAIN=40
MAX_PAGINATION_PAGES=50
CONCURRENCY=5
INTERNAL_CONCURRENCY=3

# --- Networking / politeness ---
USE_SMART_JS_FALLBACK=true
REQUEST_TIMEOUT=15
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2.0
MIN_DELAY_PER_DOMAIN=1.5
RESPECT_ROBOTS_TXT=true
# PROXY_URL=http://user:pass@proxy.example.com:8080
# PROXY_LIST=http://p1.example.com:8080,http://p2.example.com:8080
# PROXY_LIST_FILE=proxies.txt
# ROTATE_PROXIES=false

# --- Runtime ---
CHECKPOINT_EVERY_N_ITEMS=10
BANDIT_AUTO_SAVE_INTERVAL=20
PERSIST_SESSION=true
LOG_LEVEL=INFO
